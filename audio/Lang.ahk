; Text for the current language (falls back to English).
; Note: AutoHotkey names ignore case, so a local variable called "t" (or "textos")
; hides T() (or TEXTOS) inside that function.
T(chave) {
    dic := TEXTOS[Cfg.idioma]
    return dic.Has(chave) ? dic[chave] : TEXTOS["en"][chave]
}
